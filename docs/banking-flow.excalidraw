      "updated": 1758790800000,
      "link": null,
      "locked": false,
      "text": "Every money-moving step: create a quote → re-enter the PIN for that one intent (step-up token) → confirm. Balances change only through balanced ledger entries.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every money-moving step: create a quote → re-enter the PIN for that one intent (step-up token) → confirm. Balances change only through balanced ledger entries.",
      "lineHeight": 1.25,
      "autoResize": true
    },
